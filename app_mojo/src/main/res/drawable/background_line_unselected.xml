<?xml version="1.0" encoding="utf-8"?>

<!-- Text input box: darker than the page so it looks sunk in, thin grey outline -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_bg_deep"/>
            <corners android:radius="3dp"/>
            <stroke
                android:width="@dimen/_1sdp"
                android:color="@color/ui_border_strong"/>
        </shape>
    </item>
    <item android:drawable="?attr/selectableItemBackground"/>
    <item>
        <shape android:shape="rectangle">
            <padding
                android:bottom="@dimen/padding_input_bottom"
                android:top="@dimen/padding_input_top" />
        </shape>
    </item>
</layer-list>
