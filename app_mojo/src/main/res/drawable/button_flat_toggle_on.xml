<?xml version="1.0" encoding="utf-8"?>
<!-- Toggle ON: normal button with a bright blue strip under it -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_accent_bright"/>
            <corners android:radius="3dp"/>
            <size android:height="25dp"/>
        </shape>
    </item>
    <item android:bottom="5dp" android:drawable="@drawable/button_flat"/>
</layer-list>
