<?xml version="1.0" encoding="utf-8"?>
<!-- Menu row: dark square card with a thin blue bar on the left edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1dp border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_border"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    <!-- 3dp blue bar on the left -->
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_accent_dim"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
    <!-- Row face -->
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:left="4dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface"/>
            <corners
                android:topLeftRadius="0dp"
                android:bottomLeftRadius="0dp"
                android:topRightRadius="2dp"
                android:bottomRightRadius="2dp"/>
        </shape>
    </item>
</layer-list>
