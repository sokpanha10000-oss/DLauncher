<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bedrock_shadow_disabled"/>
            <corners android:radius="12dp"/>
            <stroke android:width="2dp" android:color="@color/bedrock_outline"/>
        </shape>
    </item>
    <item android:top="0dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/bedrock_ring_disabled" android:endColor="@color/bedrock_face_disabled"/>
            <corners android:radius="12dp"/>
            <stroke android:width="2dp" android:color="@color/bedrock_outline"/>
        </shape>
    </item>
</layer-list>
