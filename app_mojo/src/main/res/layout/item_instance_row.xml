<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_row_normal"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_52sdp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/padding_heavy"
    android:paddingTop="@dimen/padding_moderate"
    android:paddingEnd="@dimen/padding_medium"
    android:paddingBottom="@dimen/padding_moderate">

    <ImageView
        android:id="@+id/instance_row_icon"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_heavy"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/instance_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/instance_row_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_10ssp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/instance_row_edit"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:background="@drawable/menu_row_background"
        android:contentDescription="@string/menu_edit_instance"
        android:focusable="false"
        android:padding="@dimen/padding_moderate"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_px_edit" />
</LinearLayout>
