<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="control_button_color">#4CC4C4C4</color>
    <color name="control_button_pressed_color">#4D000000</color>

    <!-- =====================================================================
         Midnight Blue palette: dark, flat, square. Blue is the only accent.
         Change the ui_accent* values to re-color the whole launcher.
         ===================================================================== -->

    <!-- Backgrounds, darkest to lightest -->
    <color name="ui_bg_deep">#05070C</color>
    <color name="ui_bg">#080C14</color>
    <color name="ui_surface">#0D121C</color>
    <color name="ui_surface_raised">#141A27</color>
    <color name="ui_surface_hover">#1B2334</color>
    <color name="ui_border">#1E2738</color>
    <color name="ui_border_strong">#2E3B56</color>

    <!-- Blue accent (this replaces the old green / yellow) -->
    <color name="ui_accent_bright">#5B9DFF</color>
    <color name="ui_accent_light">#2865EB</color>
    <color name="ui_accent">#1F5BE0</color>
    <color name="ui_accent_pressed">#1B4FC9</color>
    <color name="ui_accent_dim">#1B3A7A</color>
    <color name="ui_accent_glow">#0E2247</color>

    <!-- Text -->
    <color name="ui_text">#F1F5FB</color>
    <color name="ui_text_muted">#8B97AE</color>
    <color name="ui_text_disabled">#4B576D</color>

    <!-- Glow at the top of every screen (see drawable/background_sky) -->
    <color name="ui_glow_start">#262563EB</color>
    <color name="ui_glow_end">#002563EB</color>

    <!-- =====================================================================
         Old names, kept so the rest of the app (and any code that is not in
         this zip) still finds them. They now point at the palette above.
         ===================================================================== -->
    <color name="sky_top">#0D1424</color>
    <color name="sky_bottom">@color/ui_bg_deep</color>
    <color name="sky_navy">@color/ui_border</color>
    <color name="sky_cloud">@color/ui_text</color>
    <color name="sky_sun">@color/ui_accent_bright</color>

    <color name="minebutton_color">@color/ui_accent_bright</color>
    <color name="minebutton_secondary">@color/ui_accent_dim</color>
    <color name="background_app">@color/ui_bg</color>
    <color name="divider">@color/ui_border</color>
    <color name="background_overlay">@color/ui_border</color>
    <color name="background_status_bar">@color/ui_surface</color>
    <color name="background_bottom_bar">@color/ui_surface</color>
    <color name="background_nav">@color/ui_bg_deep</color>
    <color name="icon_outline_color">#FFFFFF</color>

    <color name="primary_text">@color/ui_text</color>
    <color name="secondary_text">@color/ui_text_muted</color>
    <color name="button_text">@color/ui_text</color>

    <color name="bedrock_outline">@color/ui_border_strong</color>
    <color name="bedrock_face">@color/ui_surface_raised</color>
    <color name="bedrock_ring">@color/ui_border_strong</color>
    <color name="bedrock_shadow">@color/ui_border</color>
    <color name="bedrock_face_pressed">@color/ui_surface_hover</color>
    <color name="bedrock_ring_pressed">@color/ui_accent_bright</color>
    <color name="bedrock_face_disabled">@color/ui_surface</color>
    <color name="bedrock_ring_disabled">@color/ui_border</color>
    <color name="bedrock_shadow_disabled">@color/ui_bg</color>

    <color name="bedrock_green_face">@color/ui_accent</color>
    <color name="bedrock_green_ring">@color/ui_accent_bright</color>
    <color name="bedrock_green_shadow">@color/ui_accent_dim</color>
    <color name="bedrock_green_face_pressed">@color/ui_accent_pressed</color>
    <color name="bedrock_green_ring_pressed">@color/ui_accent_bright</color>

    <color name="bedrock_row_face">@color/ui_surface</color>
    <color name="bedrock_row_ring">@color/ui_border_strong</color>
    <color name="bedrock_row_shadow">@color/ui_border</color>
    <color name="bedrock_row_face_pressed">@color/ui_accent_glow</color>
    <color name="bedrock_panel_face">@color/ui_surface</color>
    <color name="bedrock_panel_ring">@color/ui_border_strong</color>
</resources>
