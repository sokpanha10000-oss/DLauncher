<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or not? -->
    <style name="MojoLauncher" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_nav</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="dialogCornerRadius">16dp</item>
        <item name="android:seekBarStyle">@style/MojoLauncher.SeekBar</item>
        <item name="seekBarStyle">@style/MojoLauncher.SeekBar</item>
        <item name="android:switchStyle">@style/MojoLauncher.Switch</item>
        <item name="switchStyle">@style/MojoLauncher.Switch</item>
        <item name="buttonStyle">@style/MojoLauncher.Button</item>
        <item name="android:buttonStyleToggle">@style/MojoLauncher.Button.Toggle</item>

        <!-- Blue Sky look: sky gradient, cloud buttons, light blue accent -->
        <item name="colorPrimary">@color/background_status_bar</item>
        <item name="colorPrimaryDark">@color/background_status_bar</item>
        <item name="colorAccent">@color/minebutton_color</item>
        <item name="colorControlActivated">@color/minebutton_color</item>
        <item name="colorControlNormal">@color/secondary_text</item>
        <item name="colorControlHighlight">#33FFFFFF</item>
        <item name="colorButtonNormal">@color/bedrock_face</item>
        <item name="colorBackgroundFloating">@color/bedrock_panel_face</item>
        <item name="android:colorBackground">@color/background_app</item>
        <item name="android:listDivider">@drawable/divider_sky</item>
        <item name="android:windowBackground">@drawable/background_sky</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="alertDialogTheme">@style/MojoLauncher.Dialog</item>
    </style>

    <style name="MojoLauncher.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/background_dialog</item>
        <item name="colorAccent">@color/minebutton_color</item>
        <item name="buttonBarButtonStyle">@style/MojoLauncher.DialogButton</item>
    </style>

    <style name="MojoLauncher.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/minebutton_color</item>
    </style>

    <style name="MojoLauncher.AppTheme" parent="MojoLauncher"/>

    <style name="MojoLauncher.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/minepb_progress</item>
        <item name="android:thumb">@drawable/mineknob_on_unfiltered</item>
        <item name="android:thumbOffset">0dp</item>
        <item name="android:maxHeight">4dp</item>
        <item name="android:minHeight">4dp</item>
    </style>

    <style name="MojoLauncher.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="track">@drawable/mineknob_track_mask_unfiltered</item>
        <item name="trackTint">@color/mineknob_track_tint</item>
        <item name="trackTintMode">multiply</item>
        <item name="android:thumb">@drawable/mineknob_switch</item>
        <item name="switchMinWidth">40dp</item>
    </style>

    <style name="MojoLauncher.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_flat</item>
        <item name="android:textColor">@color/button_text_color</item>
        <item name="android:paddingStart">@dimen/padding_heavy</item>
        <item name="android:paddingEnd">@dimen/padding_heavy</item>
        <item name="android:paddingTop">@dimen/padding_medium</item>
        <item name="android:paddingBottom">@dimen/padding_moderate</item>
    </style>

    <style name="MojoLauncher.Button.Toggle" parent="MojoLauncher.Button">
        <item name="android:background">@drawable/button_flat_toggle</item>
    </style>


    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/menu_row_background</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:layout_marginStart">@dimen/padding_heavy</item>
        <item name="android:layout_marginEnd">@dimen/padding_heavy</item>
        <item name="android:layout_marginTop">@dimen/padding_moderate</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_66sdp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>
</resources>
